# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# data: build-only files stay local. reference.db (114 MB) is over GitHub's 100 MB file limit, so the repo carries
# reference.db.gz (26 MB) and the build unpacks it (npm run prebuild)
/data/raw/
/data/export_desk.db*
/data/*.gz
!/data/reference.db.gz
/data/rag_eval*
/data/*.log
/data/local.db
/data/uploads/
/data/reference.db
.env
.env.*
!.env.example
