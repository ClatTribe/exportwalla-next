# Copy to .env (local) and set the same values in the Vercel project (Settings > Environment Variables).
# Everything is optional for a local run.

# Where a build downloads data/reference.db(.gz) when it is not in the upload (Hobby plan upload limit). Optional.
REFERENCE_DB_URL=

# Public origin: canonical URLs, sitemap, structured data, llms.txt, the MCP card. Required for a release.
SITE_URL=https://www.example.com

# The desk: shown on every page and in structured data. A production deploy refuses the placeholder number.
DESK_PHONE=+91 00000 00000
DESK_WHATSAPP=
CONTACT_EMAIL=
LEGAL_NAME=
BUSINESS_ADDRESS=
GRIEVANCE_OFFICER=
PRICE_FROM_INR=12,000
FX_AS_OF=2 Nov 2026

# Where contact forms go (set at least one for production). Email: any SMTP mailbox, e.g. Gmail/Google Workspace with
# an app password (SMTP_HOST=smtp.gmail.com, SMTP_PORT=587). LEAD_EMAIL_TO defaults to CONTACT_EMAIL.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
LEAD_EMAIL_TO=
LEAD_WEBHOOK_URL=
# Review verdicts from the review console on a deploy
REVIEW_WEBHOOK_URL=

# Operator tools (review mode, /review console). Without a token a deploy keeps them closed.
OPERATOR_TOKEN=

# AI (optional). Claude: ANTHROPIC_API_KEY (CLAUDE_MODEL to override). Or Gemini (free tier works): GEMINI_API_KEY,
# GEMINI_MODEL. LLM_PROVIDER=anthropic|gemini picks one when both are set. Without either, the site works with OCR
# (local only), the tariff search and retrieved passages.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
LLM_PROVIDER=

# Search engines: Search Console / Bing Webmaster tokens (HTML-tag method); IndexNow key (any 32 hex characters),
# served at /<key>.txt and used by `npm run check -- indexnow` after a release.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=

# Off switches (tests, offline work): UK_SEARCH=off, COMTRADE_FETCH=off
